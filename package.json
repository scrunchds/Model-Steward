{
  "name": "model-steward",
  "version": "0.1.2",
  "private": true,
  "description": "Local-first, privacy-preserving model evaluation and routing for coding agents.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "allowScripts": {
    "esbuild": true,
    "@google/genai": false,
    "protobufjs": false
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "COMMERCIAL-LICENSE.md",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/pi/extension.d.ts",
      "default": "./dist/pi/extension.js"
    }
  },
  "bin": {
    "model-steward": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "audit:security": "node scripts/audit.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run audit:security",
    "deps:check": "npm outdated --long",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run",
    "release:guard": "node scripts/release-guard.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.40.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
